{
	"name": "ezmon",
	"version": "1.0.1",
	"module": "./src/server.js",
	"private": true,
	"scripts": {
		"install:client": "cd client && bun install",
		"install:server": "bun install",
		"install:all": "npm run install:server && npm run install:client",
		"dev:client": "cd client && bun dev",
		"dev:server": "bun --env-file .env --watch src/server.js",
		"dev:worker": "bun --watch src/worker.js",
		"dev": "conc -n \"CLIENT,API,WORKER\" -c \"cyan,magenta,yellow\" \"npm run dev:client\" \"npm run dev:server\" \"npm run dev:worker\"",
		"build-client": "cd client && bun run build",
		"build:all": "npm run build-client",
		"start": "pm2-runtime start ecosystem.config.js --env production",
		"stop": "pm2 stop all",
		"restart": "pm2 restart all",
		"logs": "pm2 monit",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"test:backend": "bun test tests",
		"test:frontend": "cd client && bun run test",
		"test": "bun run test:backend && bun run test:frontend"
	},
	"dependencies": {
		"@elysiajs/openapi": "^1.4.17",
		"@elysiajs/static": "^1.4.12",
		"cron": "^4.4.1",
		"deadslog": "^2.0.0",
		"elysia": "^1.4.32",
		"mongoose": "^9.12.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"concurrently": "^10.0.7",
		"@biomejs/biome": "2.6.8"
	}
}
