# MongoDB connection. Only used in dev/local.
MONGO_URI = # Your mongo uri. only used in dev environment

# API key for write operations (create/update/delete sites).
API_KEY = # Your API key

# --- Alerting (optional; leave unset to disable that channel) ---
# Enable per-site in the "Alerts" section of the Add Site form.
# Telegram
TELEGRAM_BOT_API =     # e.g. https://api.telegram.org/bot<TOKEN>
TELEGRAM_CHAT_ID =     # e.g. 123456789
# Discord
DISCORD_WEBHOOK_URL =  # e.g. https://discord.com/api/webhooks/...
# Slack
SLACK_WEBHOOK_URL =    # e.g. https://hooks.slack.com/services/...
# Email (via any JSON webhook that accepts { subject, text })
SMTP_ALERT_WEBHOOK_URL =